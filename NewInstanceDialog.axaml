<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CitrineLauncher.NewInstanceDialog"
        Title="New Instance"
        Width="560" Height="500" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White"
        CanResize="True">

    <Grid Margin="24,20,24,20" RowDefinitions="Auto, *, Auto">
        <TextBlock Text="Create New Instance" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource CitrineBrush}"/>

        <ScrollViewer Grid.Row="1" Margin="0,16" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FormPanel" Spacing="10">

            <!-- Loader selector (always visible, shown first) -->
            <ComboBox x:Name="LoaderCombo"
                      PlaceholderText="Loader" AutomationProperties.Name="Mod loader"
                      Background="#2A2A2A"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      Padding="10,8"/>

            <!-- Minecraft version (always visible) -->
            <ComboBox x:Name="VersionCombo"
                      PlaceholderText="Select Minecraft version" AutomationProperties.Name="Minecraft version"
                      Background="#2A2A2A"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      Padding="10,8"/>

            <!-- Optional name for either manual or pack instances. -->
            <TextBox x:Name="NameInput"
                     Watermark="Instance name (optional)" AutomationProperties.Name="Instance name"
                     Background="#2A2A2A"
                     BorderBrush="#333"
                     Padding="10"
                     />

            <!-- Pack manifests own their Minecraft and loader versions. -->
            <Grid x:Name="ModpackRow" ColumnDefinitions="*, Auto, Auto, Auto">
                <TextBox x:Name="ModpackPathBox"
                         Grid.Column="0"
                         Watermark="Modpack (.zip / .mrpack)"
                         Background="#2A2A2A"
                         BorderBrush="#333"
                         IsReadOnly="True"
                         Padding="10" AutomationProperties.Name="Selected modpack"/>
                <Button x:Name="BrowseModpackButton"
                        Grid.Column="1"
                        Content="Local"
                        Height="36"
                        Margin="6,0,0,0"
                        Background="#2A2A2A"
                        Foreground="White"
                        CornerRadius="6"
                        Click="BrowseModpackButton_Click"/>
                <Button x:Name="BrowseModrinthButton"
                        Grid.Column="2"
                        Content="Modrinth"
                        Height="36"
                        Margin="6,0,0,0"
                        Background="{StaticResource CitrineBrush}"
                        Foreground="Black"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Click="BrowseModrinthButton_Click"/>
                <Button Grid.Column="3" Content="Clear" Click="ClearPackButton_Click" Margin="6,0,0,0" AutomationProperties.Name="Clear selected pack"/>
            </Grid>
            <CheckBox x:Name="IncludeOptionalCheck" Content="Include optional client files" IsChecked="True" IsVisible="False"/>

            <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="StatusText"
                       Foreground="#AAAAAA"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="False"/>

            <TextBlock AutomationProperties.LiveSetting="Assertive" x:Name="ErrorText"
                       Foreground="#FF6B6B"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="80" Height="32"
                    IsCancel="True" Click="CancelButton_Click" Background="#2A2A2A" Foreground="White"
                    CornerRadius="6"/>
            <Button x:Name="CreateButton" Content="Create" Width="80" Height="32"
                    Click="CreateButton_Click"
                    Background="{StaticResource CitrineBrush}"
                    Foreground="Black"
                    FontWeight="Bold"
                    CornerRadius="6"/>
        </StackPanel>
    </Grid>
</Window>
