<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:handlers="clr-namespace:CitrineLauncher.Handlers" x:Class="CitrineLauncher.SettingsPanel"
 x:DataType="handlers:Settings" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="8">
   <StackPanel x:Name="GeneralSection" Spacing="8">
    <TextBlock Text="Memory allocation" FontWeight="SemiBold" FontSize="13"/>
    <Grid ColumnDefinitions="120,110,Auto">
     <TextBlock Text="Minimum RAM (MB)" VerticalAlignment="Center" FontSize="12"/>
     <ComboBox Grid.Column="1" x:Name="MinRamCombo" Width="110" ItemsSource="{Binding RamOptions}" SelectedItem="{Binding MinRam}" AutomationProperties.Name="Minimum RAM in megabytes"/>
     <TextBox Grid.Column="1" x:Name="MinRamTextBox" Width="100" IsVisible="False" Text="{Binding MinRam, Mode=OneTime}" AutomationProperties.Name="Custom minimum RAM in megabytes"/>
     <CheckBox Grid.Column="2" Margin="10,0,0,0" x:Name="MinRamCustomCheck" Content="Custom" IsChecked="{Binding UseCustomMinRam, Mode=OneTime}"/>
    </Grid>
    <Grid ColumnDefinitions="120,110,Auto">
     <TextBlock Text="Maximum RAM (MB)" VerticalAlignment="Center" FontSize="12"/>
     <ComboBox Grid.Column="1" x:Name="MaxRamCombo" Width="110" ItemsSource="{Binding RamOptions}" SelectedItem="{Binding MaxRam}" AutomationProperties.Name="Maximum RAM in megabytes"/>
     <TextBox Grid.Column="1" x:Name="MaxRamTextBox" Width="100" IsVisible="False" Text="{Binding MaxRam, Mode=OneTime}" AutomationProperties.Name="Custom maximum RAM in megabytes"/>
     <CheckBox Grid.Column="2" Margin="10,0,0,0" x:Name="MaxRamCustomCheck" Content="Custom" IsChecked="{Binding UseCustomMaxRam, Mode=OneTime}"/>
    </Grid>
    <TextBlock x:Name="RamErrorLabel" IsVisible="False" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel x:Name="AccountsSection" IsVisible="False" Spacing="8">
    <TextBlock Text="Saved accounts" FontWeight="SemiBold" FontSize="13"/>
    <WrapPanel Orientation="Horizontal">
     <Button x:Name="AddMicrosoftButton" Content="Add Microsoft" Classes="secondary" Margin="0,0,6,0"/>
     <Button x:Name="AddOfflineButton" Content="Add Offline" Classes="secondary"/>
    </WrapPanel>
    <Grid ColumnDefinitions="*,Auto">
     <ListBox x:Name="AccountsList" Height="140" AutomationProperties.Name="Accounts">
      <ListBox.ItemTemplate><DataTemplate x:DataType="handlers:Account">
       <Grid ColumnDefinitions="*,Auto" Margin="4,2">
        <TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Username}" FontSize="12"/>
        <TextBlock Grid.Column="1" Text="{Binding Type}" Margin="8,0,0,0" FontSize="11" Foreground="#B0B0B0"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
      <ListBox.ContextMenu><ContextMenu><MenuItem Header="Edit" Click="EditMenuItem_Click"/><MenuItem Header="Remove" Click="DeleteMenuItem_Click"/></ContextMenu></ListBox.ContextMenu>
     </ListBox>
     <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
      <Button x:Name="EditAccountButton" Content="Edit" Classes="secondary" Click="EditMenuItem_Click" IsEnabled="False"/>
      <Button x:Name="RemoveAccountButton" Content="Remove" Classes="secondary" Click="DeleteMenuItem_Click" IsEnabled="False"/>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="AccountEditor" IsVisible="False" Spacing="6">
     <Grid ColumnDefinitions="120,Auto"><TextBlock Text="Offline username" FontSize="12" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="UsernameInput" Width="180" MaxLength="16" AutomationProperties.Name="Offline username"/></Grid>
     <StackPanel Orientation="Horizontal" Spacing="6" Margin="120,0,0,0"><Button x:Name="SaveAccountButton" Content="Add" Classes="primary"/><Button x:Name="CancelAccountButton" Content="Cancel" Classes="secondary"/></StackPanel>
    </StackPanel>
    <TextBlock x:Name="AccountErrorLabel" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
   </StackPanel>
   <StackPanel x:Name="AppearanceSection" IsVisible="False" Spacing="8">
    <TextBlock Text="Launcher appearance" FontWeight="SemiBold" FontSize="13"/>
    <Grid ColumnDefinitions="120,Auto"><TextBlock Text="Theme" FontSize="12" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ThemeBox" Width="140" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme"/></Grid>
    <CheckBox IsChecked="{Binding ParticlesEnabled}" Content="Enable particle effects"/>
    <Grid ColumnDefinitions="120,180,Auto"><TextBlock Text="Particle density" FontSize="12" VerticalAlignment="Center"/><Slider Grid.Column="1" Width="180" Minimum="0" Maximum="100" Value="{Binding ParticleDensity}" AutomationProperties.Name="Particle density"/><TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding ParticleDensity, StringFormat='{}{0}%'}"/></Grid>
   </StackPanel>
   <StackPanel x:Name="PerformanceSection" IsVisible="False" Spacing="8">
    <TextBlock Text="Launch behavior" FontWeight="SemiBold" FontSize="13"/>
    <CheckBox IsChecked="{Binding MinimizeOnLaunch}" Content="Minimize launcher when game starts"/>
    <CheckBox IsChecked="{Binding ShowConsole}" Content="Show Minecraft console window"/>
    <TextBlock Text="Minecraft folder" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0"/>
    <TextBlock x:Name="FolderPathTextBlock" FontSize="12" TextWrapping="Wrap"/>
    <TextBox x:Name="FolderPathTextBox" IsVisible="False" Watermark="Enter absolute path…" AutomationProperties.Name="Minecraft folder"/>
    <Button x:Name="ChangeFolderButton" Classes="secondary" Content="Change" HorizontalAlignment="Left"/>
    <TextBlock x:Name="FolderErrorLabel" IsVisible="False" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
