<local:WorkspacePage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:models="clr-namespace:CitrineLauncher.Models" xmlns:local="clr-namespace:CitrineLauncher"
                     x:Class="CitrineLauncher.ModsView">
    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock x:Name="Heading" IsVisible="False"/>
            <TextBlock x:Name="InstanceInfo" Foreground="#B0B0B0" FontSize="12"/>
        </StackPanel>
        <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="BrowseButton" Content="Find mods" Classes="primary" Click="BrowseButton_Click" Margin="0,0,6,0"/>
            <Button x:Name="LocalButton" Content="Add JARs…" Click="LocalButton_Click" Margin="0,0,6,0"/>
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="ModsList" AutomationProperties.Name="Installed mods" Background="#202020"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ModsList_SelectionChanged">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,5"/></Style></ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledMod">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#B0B0B0" FontSize="11" Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="No mods yet. Find mods or add a JAR." Foreground="#B0B0B0" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" Margin="12"/>
        </Grid>
        <ScrollViewer Grid.Row="3" MaxHeight="48" Margin="0,6" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="StatusText" Foreground="#B0B0B0" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
            <Button x:Name="ToggleButton" Content="Disable" IsEnabled="False" Click="ToggleButton_Click"/>
            <Button x:Name="RemoveButton" Content="Remove…" IsEnabled="False" Click="RemoveButton_Click"/>
            <Button Content="Back" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</local:WorkspacePage>
