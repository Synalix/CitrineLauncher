<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CitrineLauncher.Models" x:Class="CitrineLauncher.ModsDialog"
        Title="Instance mods" Width="780" Height="580" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Window.Styles><StyleInclude Source="avares://CitrineLauncher/Styles/Shared.axaml"/></Window.Styles>
    <Grid Margin="24" RowDefinitions="Auto, Auto, *, Auto, Auto">
        <StackPanel Spacing="6" Margin="0,0,0,16">
            <TextBlock x:Name="Heading" Text="Instance mods" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CitrineBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InstanceInfo" Foreground="#CCCCCC" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="BrowseButton" Classes="primary" Content="Add from Modrinth" Click="BrowseButton_Click" Margin="0,0,8,8"/>
            <Button x:Name="LocalButton" Classes="secondary" Content="Add local JARs" Click="LocalButton_Click" Margin="0,0,8,8"/>
            <Button x:Name="RefreshButton" Classes="secondary" Content="Refresh" Click="RefreshButton_Click" Margin="0,0,8,8"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="ModsList" AutomationProperties.Name="Installed mods"
                     Background="#252525" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ModsList_SelectionChanged">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledMod">
                        <Grid ColumnDefinitions="*, Auto" Margin="8" RowDefinitions="Auto, Auto">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource CitrineBrush}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Row="1" Text="{Binding Source}" Foreground="#B0B0B0" FontSize="12" Margin="0,4,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="No mods installed. Add a mod from Modrinth or select a local JAR."
                       TextWrapping="Wrap" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="24" IsHitTestVisible="False"/>
        </Grid>
        <ScrollViewer Grid.Row="3" MaxHeight="90" Margin="0,12" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#CCCCCC"
                   AutomationProperties.LiveSetting="Polite"/>
        </ScrollViewer>
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto">
            <WrapPanel>
                <Button x:Name="ToggleButton" Classes="secondary" Content="Disable" IsEnabled="False" Click="ToggleButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="RemoveButton" Classes="secondary" Content="Remove…" IsEnabled="False" Click="RemoveButton_Click"/>
            </WrapPanel>
            <Button Grid.Column="1" Content="Close" IsCancel="True" Click="CloseButton_Click" Padding="20,8"/>
        </Grid>
    </Grid>
</Window>
